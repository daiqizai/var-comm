      "lines": [
        {
          "line": 78,
          "text": "def draw_mixture(batch_size, generator):"
        },
        {
          "line": 80,
          "text": "        raise ValueError(\"logical batch must support exact 50/25/25 mixture\")"
        },
        {
          "line": 81,
          "text": "    branches = torch.tensor([0] * (batch_size // 2) + [1] * (batch_size // 4) + [2] * (batch_size // 4))"
        },
        {
          "line": 82,
          "text": "    branches = branches[torch.randperm(batch_size, generator=generator)]"
        },
        {
          "line": 83,
          "text": "    return branches, torch.rand(batch_size, generator=generator)"
        },
        {
          "line": 86,
          "text": "def mixed_input(batch, branches, alpha):"
        },
        {
          "line": 88,
          "text": "    interpolation = batch[\"Fb_TX\"] + alpha.reshape(shape) * (batch[\"F\"] - batch[\"Fb_TX\"])"
        },
        {
          "line": 89,
          "text": "    return torch.where((branches == 0).reshape(shape), batch[\"F\"],"
        },
        {
          "line": 90,
          "text": "                       torch.where((branches == 1).reshape(shape), batch[\"Fq\"], interpolation))"
        },
        {
          "line": 96,
          "text": "        mse, lpips = values[:, 0], values[:, 1]"
        },
        {
          "line": 97,
          "text": "        summary[branch] = {\"mse\": float(mse.mean()), \"psnr_db\": float((-10 * np.log10(np.maximum(mse, 1e-12))).mean()),"
        },
        {
          "line": 98,
          "text": "                           \"lpips\": float(lpips.mean()), \"utility\": float((mse + 0.1 * lpips).mean())}"
        },
        {
          "line": 99,
          "text": "    summary[\"mixture_utility\"] = (0.5 * summary[\"F\"][\"utility\"] + 0.25 * summary[\"Fq\"][\"utility\"]"
        },
        {
          "line": 105,
          "text": "    current = {\"mixture_utility\": float(summary[\"mixture_utility\"])}"
        },
        {
          "line": 108,
          "text": "        current[branch + \"_lpips\"] = summary[branch][\"lpips\"]"
        },
        {
          "line": 111,
          "text": "    improved = previous[\"mixture_utility\"] - current[\"mixture_utility\"] > abs(previous[\"mixture_utility\"]) * tolerances[\"relative_utility_improvement\"]"
        },
        {
          "line": 112,
          "text": "    best = {\"mixture_utility\": min(previous[\"mixture_utility\"], current[\"mixture_utility\"])}"
        },
        {
          "line": 114,
          "text": "        psnr_key, lpips_key = branch + \"_psnr\", branch + \"_lpips\""
        },
        {
          "line": 116,
          "text": "        improved = improved or previous[lpips_key] - current[lpips_key] > tolerances[\"LPIPS_improvement\"]"
        },
        {
          "line": 118,
          "text": "        best[lpips_key] = min(previous[lpips_key], current[lpips_key])"
        }
      ]
    },
