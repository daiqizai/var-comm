+def engineering_failure_roots():
+    # Only metadata wrappers can retain an explicitly diagnosed zero-science
+    # failure here. A worker/control failure is never allowlisted by this entry.
+    return {L/'b2b3_analysis_v1'/phase/'failure.json' for phase in ('B2','B3')} | {
+        L/'b2b3_analysis_v1/B2/dino/failure.json'}
+
+
+def engineering_failures(items):
+    allowed = {}
+    for item in items:
+        require(type(item['science_calls']) is int and item['science_calls'] == 0 and
+                item['scope'] == 'engineering_only' and bool(item['description']) and
+                bool(item['evidence']), 'unbounded exception')
+        evidence = {descriptor_key(d) for d in item['evidence']}
+        for d in item['evidence']:
+            checked(d)
+        for d in item.get('allowed_failure_files', []):
+            p = Path(d['path'])
+            require(p in engineering_failure_roots() and descriptor_key(d) in evidence,
+                    'failure permission outside exact engineering metadata roots/evidence')
+            checked(d)
+            require(str(p) not in allowed, 'duplicate failure permission')
+            allowed[str(p)] = d
+    return allowed
+
+
+def inspect_failures(paths, allowed):
+    retained = []
+    for p in paths:
+        p = Path(p)
+        if p.exists():
+            d = allowed.get(str(p))
+            require(d is not None, 'unknown failure: '+str(p))
+            require(checked(d) == p, 'changed failure identity')
+            retained.append(d)
+    return retained
+
+
+def current_failure_locations():
